# Configuração de Banco de Dados do Software Brava SAMU
# Desenvolvimento Local com SQLite:
DATABASE_URL=sqlite:///./brava.db

# Produção / Homologação com PostgreSQL (psycopg2):
# DATABASE_URL=postgresql+psycopg2://postgres:sua_senha@localhost:5432/brava
# POSTGRES_PASSWORD=sua_senha

# Ambiente de execução: development | production
# A carga inicial de dados (seed) só roda automaticamente em development.
APP_ENV=development

# Senhas iniciais dos usuários criados pelo seed (troca obrigatória no primeiro acesso)
# Usuário admin:
ADMIN_PASSWORD=admin123
# Usuários de campo (enfermeiro, tecnico, condutor):
EQUIPE_PASSWORD=brava123

# Origens web liberadas no CORS (separadas por vírgula, sem barra no final)
# Ex.: URL do Painel Web Administrativo. Para o Flutter Web local use: flutter run -d chrome --web-port 8080
# Em produção, informe apenas os domínios oficiais (ex.: https://brava.joinville.sc.gov.br)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
