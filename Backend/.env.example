# =============================================================================
# TEMPLATE DE CONFIGURAÇÃO — Software Brava SAMU
# -----------------------------------------------------------------------------
# INSTRUÇÕES:
#   1. Copie este arquivo para .env  (nunca commite o .env real)
#   2. Preencha todos os valores marcados com <DEFINIR>
#   3. Gere uma JWT_SECRET_KEY forte:
#        python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# AVISO DE SEGURANÇA — SENHAS COMPROMETIDAS NO HISTÓRICO GIT
# -----------------------------------------------------------------------------
# Os commits a4ae5d5 (brava.db) e f474336 (Backend/brava.db) expuseram
# hashes SHA-256 sem sal dos 4 usuários de seed no histórico público do repo.
# As senhas abaixo NÃO podem ser as mesmas que estavam nesses commits.
# Hashes expostos (SHA-256 puro, sem sal):
#   admin:      240be518fabd2724ddb6f04eeb1da5967448d786
#   equipe:     42c2a2c37dddcd761f98c38a35e5c71f0b6c0a89
#
# Após definir as novas senhas neste arquivo, execute:
#   python Backend/rotate_passwords.py
# para aplicar os novos hashes PBKDF2 no banco de dados de produção.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de Dados
# -----------------------------------------------------------------------------

# Desenvolvimento local com SQLite (padrão quando DATABASE_URL não está definida):
# DATABASE_URL=sqlite:///./brava.db

# Produção / Homologação com PostgreSQL:
DATABASE_URL=postgresql+psycopg2://postgres:<DEFINIR>@localhost:5432/brava
POSTGRES_PASSWORD=<DEFINIR>

# -----------------------------------------------------------------------------
# Ambiente de execução
# -----------------------------------------------------------------------------
# development → executa seed automático na inicialização
# production  → seed ignorado
APP_ENV=development

# -----------------------------------------------------------------------------
# Senhas iniciais dos usuários de seed
# ATENÇÃO: escolha senhas diferentes das que estavam nos commits a4ae5d5/f474336.
# Mínimo 12 caracteres, misture letras maiúsculas, minúsculas, números e símbolos.
# -----------------------------------------------------------------------------
# Usuário admin (perfil ADMINISTRADOR):
ADMIN_PASSWORD=<DEFINIR_MIN_12_CHARS>

# Usuários de campo (enfermeiro, tecnico, condutor):
EQUIPE_PASSWORD=<DEFINIR_MIN_12_CHARS>

# Forçar troca de senha no primeiro acesso (recomendado: true)
SEED_TROCAR_SENHA=true

# -----------------------------------------------------------------------------
# CORS — origens web autorizadas
# -----------------------------------------------------------------------------
# Em produção, informe apenas domínios oficiais (sem barra no final).
# Ex.: https://brava.joinville.sc.gov.br
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# -----------------------------------------------------------------------------
# Autenticação JWT
# -----------------------------------------------------------------------------
# Gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<DEFINIR_CHAVE_FORTE_64_BYTES>
JWT_ALGORITHM=HS256
# Tempo de validade do token em minutos (padrão: 1440 = 24h)
# Reduza temporariamente para invalidar sessões abertas após rotação de senhas.
JWT_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# Rate limit de autenticação (proteção contra força bruta)
# -----------------------------------------------------------------------------
LOGIN_RATE_LIMIT=5/minute

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
# DEBUG=true recarrega ao salvar (somente desenvolvimento)
DEBUG=true
# 0.0.0.0 aceita conexões da rede (Docker, tablet na mesma Wi-Fi)
HOST=127.0.0.1
PORT=8000

# -----------------------------------------------------------------------------
# Integração com a API da Prefeitura (RF06)
# -----------------------------------------------------------------------------
# Sem URL ou token, a integração fica desligada (fichas ficam com status PENDENTE).
PREFEITURA_API_URL=https://api.joinville.sc.gov.br/saude/samu/v1
# Token fornecido pela Prefeitura — não versionar o valor real
PREFEITURA_API_TOKEN=
PREFEITURA_API_TIMEOUT=10
