@startuml c4Nivel1
!include https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Context.puml

title Diagrama de Contexto (Nível 1): Sistema de Gestão de Atendimentos SAMU

' ========================================================
' Pessoas (Usuários diretos do Sistema)
' ========================================================

Person(admin, "Administrador", "Gerencia usuários, unidades, relatórios e configurações gerais do sistema.\n\n[Acesso via Interface Web. Entrega Secundária]")

Person(equipe_samu, "Equipe de Atendimento", "Enfermeiros, Técnicos e Motoristas que realizam o atendimento e preenchem a ficha técnica digital.\n\n[Acesso via Aplicativo Mobile. Entrega Principal]")

' ========================================================
' Sistema Principal — Composto por duas interfaces distintas
' ========================================================

System(sistema_samu, "Sistema de Gestão SAMU", "Composto por duas interfaces distintas:\n\n[PRINCIPAL] Aplicativo Mobile : permite o preenchimento digital da ficha técnica de atendimento em tablets pelas equipes de campo, com funcionamento offline e geração de PDF para impressão.\n\n[SECUNDÁRIA] Interface Web Administrativa: permite ao Administrador acessar o dashboard de métricas e gerenciar cadastros de profissionais e unidades via navegador.")

' ========================================================
' Sistemas Externos
' ========================================================

System_Ext(prefeitura, "Banco da Prefeitura", "Infraestrutura municipal centralizada que armazena os dados consolidados e históricos dos atendimentos para fins de gestão.")

' ========================================================
' Relacionamentos
' ========================================================

Rel(equipe_samu, sistema_samu, "Preenche a ficha técnica digital, realiza registros de socorro e gera o PDF para impressão", "Aplicativo Mobile \n[Entrega Principal]")

Rel(admin, sistema_samu, "Gerencia permissões, perfis de usuários, cadastros e monitora métricas operacionais via dashboard", "Interface Web\n[Entrega Secundária]")

Rel(sistema_samu, prefeitura, "Sincroniza e consolida eletronicamente os dados dos atendimentos", "HTTPS / API")

' ========================================================
' Nota explicativa de hierarquia
' ========================================================

AddRelTag("principal", $textColor="green", $lineColor="green", $lineStyle=BoldLine())
AddRelTag("secundaria", $textColor="blue", $lineColor="blue", $lineStyle=DashedLine())

SHOW_LEGEND()
@enduml