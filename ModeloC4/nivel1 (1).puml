@startuml c4Nivel1

!include https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Context.puml

title Diagrama de Contexto (Nível 1) - Sistema de Gestão de Atendimentos SAMU

' ========================================================
' Pessoas (Usuários diretos do Sistema)
' ========================================================

Person(admin, "Administrador", "Gerencia usuários, unidades, relatórios e configurações gerais do sistema.")

Person(equipe_samu, "Equipe de Atendimento", "Médicos, Enfermeiros, Técnicos e Motoristas que realizam o atendimento e geram os relatórios.")

' ========================================================
' Sistema Principal (Caixa Única)
' ========================================================

System(sistema_samu, "Sistema de Gestão SAMU", "Permite o registro digital de fichas de atendimento, validação de dados, funcionamento offline e geração local de relatórios em formato PDF para impressão.")

' ========================================================
' Sistemas Externos (Única Integração Tecnológica Direta)
' ========================================================

System_Ext(prefeitura, "Banco da Prefeitura", "Infraestrutura municipal centralizada que armazena os dados consolidados e históricos dos atendimentos para fins de gestão.")

' ========================================================
' Relacionamentos Eletrônicos / Digitais
' ========================================================

Rel(admin, sistema_samu, "Gerencia permissões, perfis de usuários e monitora métricas operacionais")

Rel(equipe_samu, sistema_samu, "Preenche fichas, realiza registros de socorro e emite o PDF para impressão técnica") 

Rel(sistema_samu, prefeitura, "Sincroniza e consolida eletronicamente os dados dos atendimentos", "HTTPS / API")

' ========================================================
' Configuração de Legenda
' ========================================================

SHOW_LEGEND()
@enduml