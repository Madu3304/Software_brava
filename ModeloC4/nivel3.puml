@startuml c4Nivel3

!include https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

title Diagrama de Componentes (Nível 3) - Detalhamento da API Backend (FastAPI)

' ========================================================
' Elementos Externos à API (Atores e Containers do Nível 2)
' ========================================================
Person(admin, "Administrador", "Gerencia configurações do sistema e extrai relatórios gerenciais.")
Container(app_mobile, "Aplicativo Mobile", "Flutter / Dart", "Interface usada em campo para registro de fichas, recebimento do PDF gerado e acionamento da impressão local.")

ContainerDb(postgres, "Banco Central", "PostgreSQL", "Armazena de forma definitiva os registros operacionais e auditorias.")
System_Ext(prefeitura, "Banco da Prefeitura", "Sistema municipal receptor dos dados de atendimentos consolidados.")

' ========================================================
' Fronteira do Container: API Backend
' ========================================================
Container_Boundary(api, "API Backend (Python / FastAPI)") {

    ' Módulo de Autenticação e Segurança
    Component(auth_controller, "Auth Controller", "FastAPI Endpoints", "Recebe requisições de login e renovação de credenciais de acesso.")
    Component(security_service, "Security Service", "Python (Jose/JWT/Passlib)", "Gera tokens JWT, valida escopos de perfil por RBAC e criptografa senhas.")

    ' Módulo de Processamento de Fichas
    Component(ficha_controller, "Ficha Controller", "FastAPI Endpoints", "Disponibiliza rotas para criação, busca e retorno do binário de fichas técnicas.")
    Component(validation_service, "Validation Service", "Python (Pydantic)", "Valida a integridade dos dados obrigatórios e regras de negócio de saúde das fichas.")

    ' Módulo de Geração de Documentos e PDFs
    Component(pdf_generator, "PDF Generator Service", "Python (ReportLab/WeasyPrint)", "Renderiza os dados clínicos do atendimento em um arquivo binário padronizado PDF para impressão.")

    ' Módulo de Administração e Relatórios Operacionais
    Component(report_controller, "Report Controller", "FastAPI Endpoints", "Disponibiliza rotas para requisição de relatórios consolidados e dashboards.")

    ' Módulo de Sincronização e Integração
    Component(sync_controller, "Sync Controller", "FastAPI Endpoints", "Recebe pacotes de dados sincronizados em lote vindos dos dispositivos móveis.")
    Component(integration_service, "Integration Service", "Python (HTTPX / Requests)", "Orquestra e transmite os dados consolidados exclusivamente para a API da Prefeitura.")

    ' Camada de Dados Compartilhada
    Component(repository, "Data Repository Layer", "Python (SQLAlchemy ORM)", "Abstrai transações de banco (CRUD) utilizando o padrão de mapeamento relacional.")
}

' ========================================================
' Relacionamentos / Fluxos de Comunicação
' ========================================================

' Fluxos dos Atores/Containers para os Endpoints da API
Rel(admin, auth_controller, "Realiza autenticação administrativa", "HTTPS / JSON")
Rel(admin, report_controller, "Requisita relatórios e dados do dashboard", "HTTPS")

Rel(app_mobile, auth_controller, "Autentica usuários operacionais", "HTTPS / JSON")
Rel(app_mobile, ficha_controller, "Envia fichas preenchidas online e recebe arquivo PDF", "HTTPS / JSON + Stream")
Rel(app_mobile, sync_controller, "Envia carga de dados armazenados no SQLite", "HTTPS / JSON")

' Interações Internas do Módulo de Autenticação e Segurança
Rel(auth_controller, security_service, "Encaminha credenciais enviadas")
Rel(security_service, repository, "Consulta usuários, hashes de senhas e perfis")

' Interações Internas do Módulo de Fichas e Geração Automática do PDF
Rel(ficha_controller, validation_service, "Envia payload para validação de esquema")
Rel(ficha_controller, repository, "Persiste os registros médicos validados")
Rel(ficha_controller, pdf_generator, "Solicita geração imediata do PDF para envio ao App", "Chamada de Método")

' Interações Internas do Módulo de Sincronização e Integrações Externas
Rel(sync_controller, repository, "Salva em lote registros sincronizados")
Rel(sync_controller, integration_service, "Dispara dados consolidados para sincronismo externo")
Rel(integration_service, prefeitura, "Transmite dados de atendimentos e estatísticas", "HTTPS / REST API")

' Interações Internas do Módulo de Relatórios Gerenciais
Rel(report_controller, repository, "Busca dados históricos agregados")

' Saída da Camada de Dados para o Container do Banco Central
Rel(repository, postgres, "Executa transações de escrita e leitura SQL", "SQL / Psycopg2")

' Configuração de Legenda Obrigatória do C4
SHOW_LEGEND()
@enduml