# =============================================================================
# BANCOS DE DADOS LOCAIS — NUNCA VERSIONAR
# -----------------------------------------------------------------------------
# Os commits a4ae5d5 e f474336 introduziram arquivos .db no histórico com
# hashes de senha SHA-256 sem sal. Esses padrões evitam que isso se repita.
# Se precisar compartilhar um banco de exemplo, use dump SQL (.sql), nunca
# o arquivo binário .db.
# =============================================================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Arquivos de banco gerados pelo backend FastAPI (SQLite de desenvolvimento)
brava.db
Backend/brava.db
**/brava.db

